# Target and flash geometry (matches the reference unit)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Stock partition table (partitions.csv at project root)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# 1 ms tick: the K210 link and servo timing assume it
CONFIG_FREERTOS_HZ=1000

# External RAM. Mode/size not yet verified on hardware [V]
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
