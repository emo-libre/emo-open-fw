# Example systemd unit. Adjust paths/user; not tested on every distribution.
[Unit]
Description=EMO local server
After=network-online.target
Wants=network-online.target

[Service]
User=emo
WorkingDirectory=/opt/emoserver
ExecStart=/opt/emoserver/emoserver -c /opt/emoserver/config.json
# bind :443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/emoserver
PrivateTmp=true
# put API keys in a root-only file, e.g. EMO_ADMIN_TOKEN=... / OPENAI_API_KEY=...
EnvironmentFile=-/etc/emoserver.env

[Install]
WantedBy=multi-user.target
